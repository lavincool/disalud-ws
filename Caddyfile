# Caddy termina TLS (certificado automático de Let's Encrypt) y pasa todo a
# disalud-ws. No hace falta configurar nada para WebSocket: `reverse_proxy`
# reenvía los encabezados de upgrade tal cual desde Caddy 2.

ws.disalud.org {
	encode zstd gzip

	reverse_proxy ws:8080 {
		# Un socket inactivo puede estar minutos sin tráfico entre pings; sin esto
		# el proxy lo cortaría y el cliente reconectaría en bucle.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	log {
		output stdout
		format console
	}
}

# Equivalente en Nginx, si el VPS ya tiene uno y se prefiere no usar Caddy:
#
