# Puerto de escucha. Detrás del reverse proxy no se publica al host.
PORT=8080

# Orígenes permitidos en CORS y en el handshake, separados por comas.
# Obligatorio en producción: el handshake de socket.io empieza con un XHR
# cross-origin desde el dominio de la app hacia este host.
ALLOWED_ORIGINS=https://disalud.org,https://www.disalud.org

# Secretos compartidos con disalud-org. Genera cada uno con:
#   openssl rand -base64 48
#
# IMPORTANTE: deben ser distintos entre sí y DISTINTOS de JWT_SECRET. Si aquí se
# pusiera JWT_SECRET, un compromiso de este servidor permitiría acuñar cookies de
# sesión de la app, que duran 365 días.
REALTIME_TICKET_SECRET=
REALTIME_INTERNAL_SECRET=

# Minutos que vive un socket antes de exigir un ticket nuevo. El cliente lo
# renueva solo mientras su sesión siga viva en disalud-org.
SOCKET_TTL_MINUTES=15

# Vacío en v1: con una sola instancia no hace falta. Al escalar a varias, se
# define y el adapter de Socket.IO se activa automáticamente.
REDIS_URL=

# Nivel de pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
