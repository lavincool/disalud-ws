# Copia este fichero a `.env` y rellena los valores. `.env` no se sube al repo.
#
#   cp .env.example .env
#
# docker compose lo usa para dos cosas: pasárselo al contenedor y resolver los
# ${...} de docker-compose.yml. Sin `.env`, `docker compose up` falla.

# Puerto de escucha, dentro y fuera del contenedor. Rara vez hay que tocarlo:
# nadie llega desde internet a este puerto, solo el túnel desde la propia máquina.
PORT=8080

# Interfaz del host donde se publica el puerto. Solo la lee docker compose.
# 127.0.0.1 es lo correcto cuando cloudflared corre en esta misma máquina:
# el servicio queda invisible desde fuera. Usa 0.0.0.0 únicamente si cloudflared
# vive en otro contenedor o en otra máquina (y entonces cierra el puerto en el
# firewall).
HOST_BIND=127.0.0.1

# Orígenes permitidos en CORS y en el handshake, separados por comas.
# Obligatorio en producción: el handshake de socket.io empieza con un XHR
# cross-origin desde el dominio de la app hacia este host. Va el dominio de la
# APP (disalud.org), no el de este servidor.
ALLOWED_ORIGINS=https://disalud.org,https://www.disalud.org

# Secretos compartidos con disalud-org. Genera cada uno con:
#   openssl rand -base64 48
#
# IMPORTANTE: deben ser distintos entre sí y DISTINTOS de JWT_SECRET. Si aquí se
# pusiera JWT_SECRET, un compromiso de este servidor permitiría acuñar cookies de
# sesión de la app, que duran 365 días.
REALTIME_TICKET_SECRET=
REALTIME_INTERNAL_SECRET=

# Minutos que vive un socket antes de exigir un ticket nuevo. El cliente lo
# renueva solo mientras su sesión siga viva en disalud-org.
SOCKET_TTL_MINUTES=15

# Vacío en v1: con una sola instancia no hace falta. Al escalar a varias, se
# define y el adapter de Socket.IO se activa automáticamente.
REDIS_URL=

# Nivel de pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
