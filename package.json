{
  "name": "disalud-ws",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de tiempo real de DiSalud (Socket.IO)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "hono": "^4.7.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
